#!/usr/bin/expect -f
set timeout 20
set user "debian"
set host "116.206.199.251"
set port "2122"
set password "STTIndo26"
set cmd [lindex $argv 0]

spawn ssh -o StrictHostKeyChecking=no -p $port $user@$host $cmd
expect {
    "*assword:*" {
        send "$password\r"
        exp_continue
    }
    eof
}
